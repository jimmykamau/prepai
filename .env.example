# Which model provider to use. Defaults to "openrouter".
#   openrouter → uses OPENROUTER_API_KEY (+ OPENROUTER_MODEL)
#   google     → uses GOOGLE_GENERATIVE_AI_API_KEY (+ GOOGLE_MODEL)
AI_PROVIDER=openrouter

# --- OpenRouter (required when AI_PROVIDER=openrouter) ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional. Any slug from https://openrouter.ai/models. Default: anthropic/claude-sonnet-4.5
OPENROUTER_MODEL=

# --- Google AI Studio / Gemini (required when AI_PROVIDER=google) ---
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional. Any Gemini model id (gemini-2.5-pro, gemini-2.5-flash, ...). Default: gemini-2.5-flash
GOOGLE_MODEL=

# --- Cloudflare Turnstile (both optional; either is a no-op without the other) ---
# When set, the form renders the Turnstile widget client-side.
# Use 1x00000000000000000000AA for always-passes test traffic.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# When set, the /api/questions route verifies the token server-side.
# If unset (e.g. local dev), verification is skipped.
TURNSTILE_SECRET_KEY=
